PORT=5000

# Set to "production" on the live server.
# Leaving this unset means the app boots in development mode, which enables the
# dummy-payment path. That path is force-disabled when NODE_ENV=production.
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/restaurant-ordering

# Set TZ so revenue reports bucket by local restaurant time, not UTC.
TZ=Asia/Kolkata

# JWT Configuration
# In production the server refuses to start if this is missing, left at the
# built-in default, or shorter than 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRE=7d

# Firebase Admin service account, as a single-line JSON string.
# Used to verify phone-auth ID tokens. Never commit the .json key file.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Required for the /api/payment/webhook endpoint. Without it the webhook
# rejects every call, so paid orders are only confirmed by the browser callback.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Bypasses Razorpay entirely and marks orders paid without a real payment.
# Local development only — ignored when NODE_ENV=production.
USE_DUMMY_PAYMENT=true

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend URL — this exact origin is what CORS and Socket.io will accept.
CLIENT_URL=http://localhost:5173

# Optional: additional allowed origins, comma-separated.
# Use for a www alias or a preview deployment, e.g.
# EXTRA_ORIGINS=https://www.yourrestaurant.com,https://preview.yourrestaurant.com
EXTRA_ORIGINS=
